# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql://notebooklm:notebooklm@localhost:5432/notebooklm?schema=public

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Queue
REDIS_URL=redis://localhost:6379

# LLM / embeddings / rerank
OPENAI_API_KEY=
# Optional — defaults to "gpt-5.5" (plan §5) if unset.
OPENAI_CHAT_MODEL=
COHERE_API_KEY=

# Storage (prod)
# --- AWS S3 (file storage for PDF/text source originals) ---
# 1. Create an IAM user (IAM > Users > Create user) — do NOT use root account keys
# 2. Attach a policy scoped to only this bucket (see README > AWS S3 Setup)
# 3. Security credentials tab > Create access key > "Application running outside AWS"
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

NEXT_PUBLIC_APP_URL=http://localhost:3000
