# Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Database
DATABASE_URL=postgresql://notebooklm:notebooklm@localhost:5432/notebooklm?schema=public

# Vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Queue
REDIS_URL=redis://localhost:6379

# LLM / embeddings / rerank
OPENAI_API_KEY=
# Optional — defaults to "gpt-5.5" (plan §5) if unset.
OPENAI_CHAT_MODEL=
COHERE_API_KEY=

# Storage — leave all S3_* empty to use local disk storage (dev default,
# lib/storage/local.ts). Set S3_BUCKET (+ the rest) to switch to S3
# (lib/storage/s3.ts, dispatched via lib/storage/index.ts) — required for
# any serverless/ephemeral-filesystem deploy (e.g. Vercel). See README >
# Deployment > "Managed services" for how to create these.
# 1. Create an IAM user (IAM > Users > Create user) — do NOT use root account keys
# 2. Attach a policy scoped to only this bucket (see README > Deployment)
# 3. Security credentials tab > Create access key > "Application running outside AWS"
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

NEXT_PUBLIC_APP_URL=http://localhost:3000
